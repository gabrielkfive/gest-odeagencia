# Copie para .env (na mesma pasta) e preencha. NÃO suba o .env real pro GitHub.
# (Eu, o Claude, gero a chave e a senha pra você na hora do setup.)

# IP público da sua VM Oracle (eu pego pra você quando a VM existir)
VM_PUBLIC_IP=000.000.000.000

# Chave de acesso da Evolution (invento uma forte na hora)
EVOLUTION_API_KEY=troque-por-uma-chave-forte

# Senha do banco (invento uma forte na hora)
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Para onde a Evolution manda as mensagens recebidas (o WorkFlowArk)
WEBHOOK_URL=https://workflowark.arkcontent.workers.dev/api/workflowark/whatsapp/webhook
