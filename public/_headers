# Documentos do app SEMPRE revalidam (ETag/304): navegador nunca roda build velho.
# Os assets com hash continuam cacheáveis para sempre por padrão.
/workflowark
  Cache-Control: no-cache, must-revalidate
/workflowark.html
  Cache-Control: no-cache, must-revalidate
# Desde o split do monolito (06/09/2026) o app vive em workflowark-*.js e .css. Sem esta
# regra o navegador podia guardar o script velho por heuristica e a equipe testava a
# versao antiga com o HTML novo (o fix do arrastar "continuava" quebrado).
/workflowark-*.js
  Cache-Control: no-cache, must-revalidate
/workflowark-*.css
  Cache-Control: no-cache, must-revalidate
/propostas
  Cache-Control: no-cache, must-revalidate
/propostas.html
  Cache-Control: no-cache, must-revalidate
/contratos
  Cache-Control: no-cache, must-revalidate
/contratos.html
  Cache-Control: no-cache, must-revalidate
/comercial
  Cache-Control: no-cache, must-revalidate
/comercial.html
  Cache-Control: no-cache, must-revalidate
